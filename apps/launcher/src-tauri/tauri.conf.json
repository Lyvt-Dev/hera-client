{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hera Client",
  "version": "0.2.1",
  "identifier": "gg.hera.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hera Client",
        "width": 1200,
        "height": 720,
        "minWidth": 760,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn.modrinth.com https://media.forgecdn.net https://mediafilez.forgecdn.net; connect-src ipc: http://ipc.localhost https://piston-meta.mojang.com https://meta.fabricmc.net https://files.minecraftforge.net; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Independent Minecraft Java client",
    "category": "Game",
    "copyright": "Hera contributors",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": [
          "German",
          "English"
        ],
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "silent": true,
        "type": "downloadBootstrapper"
      }
    },
    "resources": [
      "resources/*.txt"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIyMDVBQ0JEMkFEOTc3MjIKUldRaWQ5a3F2YXdGc3Uxb2xaSjZEN3VHcVlrS3V2b2ZMOEtxOE1UVE5yU3NIV3cwZVlTSnFnTUUK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
